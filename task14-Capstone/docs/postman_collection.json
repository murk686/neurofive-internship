{
  "info": {
    "name": "Event Booking API",
    "description": "Collection covering auth, events, and bookings. Set `baseUrl` and run Signup requests first to populate tokens automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "organizerToken",
      "value": ""
    },
    {
      "key": "attendeeToken",
      "value": ""
    },
    {
      "key": "eventId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup (Organizer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('organizerToken', body.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/signup",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Olivia Organizer\",\"email\":\"organizer@example.com\",\"password\":\"password123\",\"role\":\"organizer\"}"
            }
          }
        },
        {
          "name": "Signup (Attendee)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('attendeeToken', body.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/signup",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Alex Attendee\",\"email\":\"attendee@example.com\",\"password\":\"password123\",\"role\":\"attendee\"}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"organizer@example.com\",\"password\":\"password123\"}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{organizerToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Create Event (organizer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.event) pm.collectionVariables.set('eventId', body.data.event.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{organizerToken}}"
              }
            ],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Node.js Meetup\",\"description\":\"Backend deep dive\",\"category\":\"tech\",\"location\":\"Karachi\",\"startTime\":\"2026-12-01T10:00:00Z\",\"endTime\":\"2026-12-01T12:00:00Z\",\"capacity\":50,\"price\":10}"
            }
          }
        },
        {
          "name": "List Events (pagination/filter/search)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/events?page=1&limit=10&category=tech&search=node"
          }
        },
        {
          "name": "Get Event By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/events/{{eventId}}"
          }
        },
        {
          "name": "Update Event (owner only)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{organizerToken}}"
              }
            ],
            "url": "{{baseUrl}}/events/{{eventId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Node.js Meetup (Updated)\"}"
            }
          }
        },
        {
          "name": "Delete Event (owner only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{organizerToken}}"
              }
            ],
            "url": "{{baseUrl}}/events/{{eventId}}"
          }
        },
        {
          "name": "Upload Cover Image (owner only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{organizerToken}}"
              }
            ],
            "url": "{{baseUrl}}/events/{{eventId}}/cover-image",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": ""
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Book Seats",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.booking) pm.collectionVariables.set('bookingId', body.data.booking.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{attendeeToken}}"
              }
            ],
            "url": "{{baseUrl}}/events/{{eventId}}/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\"seats\":2}"
            }
          }
        },
        {
          "name": "My Bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{attendeeToken}}"
              }
            ],
            "url": "{{baseUrl}}/bookings/me"
          }
        },
        {
          "name": "Event Bookings (organizer only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{organizerToken}}"
              }
            ],
            "url": "{{baseUrl}}/events/{{eventId}}/bookings"
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{attendeeToken}}"
              }
            ],
            "url": "{{baseUrl}}/bookings/{{bookingId}}"
          }
        }
      ]
    }
  ]
}